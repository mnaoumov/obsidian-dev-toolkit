        "default": "./dist/lib/esm/linters/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/linters/*.d.cts",
        "default": "./dist/lib/cjs/linters/*.cjs"
      }
    },
    "./linters/eslint-rules": {
      "import": {
